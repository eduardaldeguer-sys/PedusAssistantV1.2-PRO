# PedusAssistant 1.2 PRO — variables de entorno
# Copia este archivo como .env solo para desarrollo local. En Render se configuran en el panel.

# --- Imprescindible ---------------------------------------------------------
# Consola: https://console.groq.com/keys
GROQ_API_KEY=

# --- Recomendado ------------------------------------------------------------
# Clave de acceso: si la defines, solo quien la escriba puede usar tu Pedus
# (y gastar tu cuenta de Groq). El navegador la pide una vez y la recuerda.
PEDUS_ACCESS_KEY=
# Sube el límite de la API de GitHub de 60 a 5000 peticiones/hora.
# Fine-grained token sin permisos (solo lectura pública) es suficiente.
GITHUB_TOKEN=
# Tu usuario, para que "mis repos" funcione sin decir el nombre.
PEDUS_GITHUB_USER=
PEDUS_DEFAULT_VOICE=diana

# --- Modelos (DÉJALOS SIN DEFINIR salvo que quieras forzar uno) -------------
# Pedus pregunta a Groq qué modelos tiene activos tu cuenta y elige solo el mejor
# para cada cosa. Si Groq retira uno, cambia al siguiente sin tocar nada.
# Si fuerzas un modelo que ya no existe, se ignora y se avisa en el log y en
# Ajustes → Sistema → «Probar Groq».
# PEDUS_CHAT_MODEL=openai/gpt-oss-120b
# PEDUS_DEEP_MODEL=openai/gpt-oss-120b
# PEDUS_FAST_MODEL=openai/gpt-oss-20b
# PEDUS_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# PEDUS_RESEARCH_MODEL=groq/compound-mini
# PEDUS_STT_MODEL=whisper-large-v3-turbo
# PEDUS_TTS_MODEL=canopylabs/orpheus-v1-english

# --- Límites (opcional) -----------------------------------------------------
# PORT=3000
# PEDUS_RATE_CHAT=30
# PEDUS_RATE_SPEAK=90
# PEDUS_RATE_TRANSCRIBE=30
# PEDUS_MAX_MESSAGE_CHARS=4000
# PEDUS_ALLOW_OPEN_URLS=true
# PEDUS_TRUST_PROXY=1
